# PostgreSQL credentials
# Replace these placeholders with your own values in .env
DB_USER=your_postgres_username
DB_PASSWORD=replace_with_a_strong_password

# Optional pipeline settings
# For local PostgreSQL, use config/config.yaml
# For Docker, Compose sets config/docker_config.yaml
MEDIFLOW_CONFIG=config/config.yaml

# Options: full or incremental
MEDIFLOW_LOAD_MODE=full
